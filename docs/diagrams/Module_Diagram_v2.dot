digraph G {
  rankdir=LR; graph [bgcolor="white", nodesep="0.5", ranksep="0.8"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, fillcolor="#F5F7FB", color="#D3DAE7"];
