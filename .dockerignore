# Keep the build context small and make sure no secret ever enters the image.
.git
.github
.gitignore

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# Node / frontend build output
frontend/node_modules/
frontend/dist/

# Local scratch and editor folders
_tmp/
.tmp_extract/
_refs_extracted/
.vscode/
.idea/
*.log
.DS_Store
Thumbs.db
