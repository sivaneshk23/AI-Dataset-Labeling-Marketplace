# ============================================================================
# AI Dataset Labeling Marketplace - environment template (R2021 Section 6.6)
# ============================================================================
# Copy this file to `.env` and fill in real values. `.env` is listed in
# .gitignore and must NEVER be committed: the hosting platform (Render) keeps
# the production values in its dashboard instead.
#
#   cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# development | production - "production" enforces HTTPS-only security headers
# and refuses to start while a placeholder secret is still active.
ENVIRONMENT=development

# Public API name shown in the Swagger UI and in log lines.
APP_NAME=AI Dataset Labeling Marketplace API

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Any SQLAlchemy URL. PostgreSQL is used for the deployed instance; a SQLite
# URL (sqlite:///./local.db) is convenient for a quick local smoke test.
DATABASE_URL=postgresql://username:password@localhost:5432/dataset_labeling_marketplace

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# 32+ random characters. Generate with:
# python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# CORS - comma separated list of the frontend origin(s) allowed to call the API
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Security baseline (Review-II)
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=240
RATE_LIMIT_WINDOW_SECONDS=60
SECURITY_HEADERS_ENABLED=true
# Set to true only when the service runs behind a trusted proxy (Render does).
TRUST_PROXY_HEADERS=false
HSTS_MAX_AGE_SECONDS=31536000

# ---------------------------------------------------------------------------
# AI enhancement (Day 42-59)
# ---------------------------------------------------------------------------
# auto   -> use Gemini when GEMINI_API_KEY is set, otherwise the offline engine
# local  -> always use the offline similarity engine
# gemini -> force the external provider (fails over to local on error)
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Suggestions below this confidence are flagged for human review.
AI_MIN_CONFIDENCE=0.55